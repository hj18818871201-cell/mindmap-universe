OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06
PORT=3001
# Explicit demo mode. Never silently substitutes for an API failure.
DEMO_MODE=false
LOCAL_TTS_VOICE=Tingting
LOCAL_TTS_RATE=190
TTS_PROVIDER=local
# 云端部署使用 siliconflow；TTS_API_KEY 留空时复用 IMAGE_API_KEY
TTS_API_KEY=
TTS_API_BASE_URL=https://api.siliconflow.cn/v1
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna
IMAGE_API_KEY=
IMAGE_API_BASE_URL=https://api.siliconflow.cn/v1
IMAGE_MODEL=Qwen/Qwen-Image
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
